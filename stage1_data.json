# -*- coding: utf-8 -*-
import json

boxes = []
props = []

def add_box(name, x, z, w, h, d, color, rotY=None):
    b = {"name": name, "x": round(x,3), "z": round(z,3), "width": w, "height": h, "depth": d, "color": color}
    if rotY is not None:
        b["rotY"] = round(rotY,3)
    boxes.append(b)

def add_prop(ptype, x, z, rotY=None, y=0):
    p = {"type": ptype, "x": round(x,3), "y": y, "z": round(z,3)}
    if rotY is not None:
        p["rotY"] = round(rotY,3)
    props.append(p)

